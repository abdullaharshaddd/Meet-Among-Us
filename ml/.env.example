# Copy to ml/.env and start the ML service with:
#   cd ml && uv run --env-file .env uvicorn ml.service:app --port 8500
#
# A missing key does not stop the service (it also handles enrollment). It logs a
# warning at boot, and /transcribe answers 503 naming the variable for that engine.

# Which engine /transcribe uses when the request does not choose one: groq or elevenlabs.
TRANSCRIBER=groq

GROQ_API_KEY=
ELEVENLABS_API_KEY=

# Optional overrides; the defaults are in ml/ml/config.py.
# GROQ_MODEL=whisper-large-v3
# GROQ_MAX_BYTES=25165824
# ELEVENLABS_MODEL=scribe_v2

# --- Summarization (/summarize) ---
# Which model /summarize uses when the request does not choose one: groq or gemini.
# Both are called through the OpenAI chat-completions format. GROQ_API_KEY above is reused.
# Free key for Gemini: https://aistudio.google.com/apikey
SUMMARIZER=groq
GEMINI_API_KEY=

# Optional overrides (free catalogs change, so check the model ids in the provider's console).
# GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
# GEMINI_SUMMARY_MODEL=gemini-2.5-flash-lite
