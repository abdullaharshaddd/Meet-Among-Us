# Copy to .env and fill in real values. Never commit .env.
#
# --- Supabase Postgres ---
# Project dashboard -> Connect. Two different connection strings, on purpose:
# see docs/adr/0001-supabase-pooler-vs-direct-connection.md
#
# The app talks to Postgres through the transaction-mode pooler (port 6543).
DATABASE_URL=
# Alembic migrations only — direct connection (port 5432). Pooler can't run them.
DIRECT_URL=
# --- Test database (optional this phase) ---
# A second Supabase project, or any local/throwaway Postgres. If unset, the
# Postgres-backed tests skip themselves with an explanatory message.
TEST_DATABASE_URL=

# --- Cloudflare R2 (Phase 4a — enrollment audio storage) ---
# Dashboard -> R2 -> Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- ML service (Phase 4a) ---
# Where app/core/ml_client.py sends audio for embedding — see
# docs/adr/0014-ml-as-local-service.md. Defaults to localhost:8500 if unset;
# only needed here to point at a different host/port.
ML_SERVICE_URL=

# --- Invite email: Gmail SMTP (see docs/adr/0017-gmail-smtp-behind-notifier.md) ---
# SMTP_PASSWORD is a Gmail App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords), not your normal password. If SMTP_HOST is empty
# invites are still saved but marked "failed" (not configured) and can be resent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TIMEOUT_SECONDS=10
# https:// page the emailed link opens; the token is appended as /<token>.
INVITE_LINK_BASE_URL=

# --- Google Sign-In (wired up in Phase 1) ---
# Google Cloud Console -> APIs & Services -> Credentials. GOOGLE_CLIENT_ID_WEB is the
# only one the backend verifies tokens against — see docs/adr/0003. The mobile app
# requests its ID token with serverClientId=GOOGLE_CLIENT_ID_WEB so the audience
# matches. GOOGLE_CLIENT_ID_ANDROID is kept here for the mobile config; the backend
# does not use it as a token audience.
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=

# --- Session tokens (wired up in Phase 1) ---
# Signs our own access/refresh JWTs after a successful Google sign-in. Any long
# random string — e.g. `openssl rand -hex 32`. Never reuse across environments.
JWT_SECRET_KEY=

# --- Dev-only browser enrollment harness (see docs/adr/0015-dev-enrollment-harness.md) ---
# !! DEV_TOOLS_ENABLED must be false (or unset) anywhere other people can reach the server. When true it
# !! exposes /dev/enroll, /dev/transcribe and a user list, and scripts/reset_dev_data.py will run.
# Mounts /dev/enroll when true. Leave unset/false everywhere except your own
# machine — this must never be true in a deployed environment.
DEV_TOOLS_ENABLED=
