# Copy to .env and fill in real values. Never commit .env.
#
# --- Supabase Postgres ---
# Project dashboard -> Connect. Two different connection strings, on purpose:
# see docs/adr/0001-supabase-pooler-vs-direct-connection.md
#
# The app talks to Postgres through the transaction-mode pooler (port 6543).
DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Alembic migrations only — direct connection (port 5432). Pooler can't run them.
DIRECT_URL=postgresql+psycopg://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres

# --- Test database (optional this phase) ---
# A second Supabase project, or any local/throwaway Postgres. If unset, the
# Postgres-backed tests skip themselves with an explanatory message.
TEST_DATABASE_URL=

# --- Cloudflare R2 (wired up in Phase 4a — not read by any code yet) ---
# Dashboard -> R2 -> Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Resend (wired up in Phase 2) ---
# https://resend.com/api-keys — free tier only sends to your own address
# until intellivisionai.com is verified as a sending domain.
RESEND_API_KEY=

# --- Google Sign-In (wired up in Phase 1) ---
# Google Cloud Console -> APIs & Services -> Credentials. Need both client IDs
# because the mobile app and any server-side verification use different ones.
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=
