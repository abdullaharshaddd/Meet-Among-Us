# Copy to .env and fill in for your setup. Never commit .env.
# localhost works for web/simulator; a physical device needs your machine's
# LAN IP (or a tunnel) — see the Task 4 setup steps.
EXPO_PUBLIC_API_URL=http://localhost:8001
# Same value as backend/.env's google_client_id_web (not a secret).
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
