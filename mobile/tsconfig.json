{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Lets `tsc` resolve bare imports like "./GoogleSignInButton" to the
    // platform-suffixed file (.native.tsx here; Android is the primary
    // target) the same way Metro does at bundle time, instead of only
    // finding it when the exact suffixed filename is imported.
    "moduleSuffixes": [".native", ""],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
